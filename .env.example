# ---------------------------------------------------------------------------
# DRG environment configuration -- copy to `.env` and fill in.
# Everything here is OPTIONAL: the pipeline runs offline with public/no-key
# APIs and a synthetic fallback dataset when keys are absent.
# ---------------------------------------------------------------------------

# OpenWeatherMap (https://openweathermap.org/api) -- current weather + forecast.
# Without it, DRG falls back to the key-free Open-Meteo public API.
DRG_OPENWEATHER_API_KEY=

# National Grid ESO Carbon Intensity API needs no key (https://api.carbonintensity.org.uk)
DRG_CARBON_INTENSITY_BASE_URL=https://api.carbonintensity.org.uk

# Target neighbourhood (Low Carbon London => Greater London)
DRG_LATITUDE=51.5072
DRG_LONGITUDE=-0.1276
DRG_REGION_ID=13

# Paths
DRG_DATA_DIR=data
DRG_ARTIFACT_DIR=artifacts

# --- Azure (only needed for cloud deployment) ------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-drg-dev
AZURE_LOCATION=uksouth
DRG_AZURE_STORAGE_ACCOUNT=
DRG_AZURE_CONTAINER=drg
DRG_KEY_VAULT_NAME=
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZUREML_WORKSPACE_NAME=
