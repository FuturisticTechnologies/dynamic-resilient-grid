# =============================================================================
# DRG decision-support API -- FastAPI on Azure Container Apps
# =============================================================================
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DRG_DATA_DIR=/app/data \
    DRG_ARTIFACT_DIR=/app/artifacts

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libgomp1 curl \
 && rm -rf /var/lib/apt/lists/*

# dependency layer first so code edits do not invalidate the wheel cache
COPY requirements.txt requirements-azure.txt ./
RUN pip install --upgrade pip \
 && pip install -r requirements.txt -r requirements-azure.txt

COPY pyproject.toml README.md ./
COPY configs ./configs
COPY src ./src
RUN pip install --no-deps -e .

# data and model artifacts are mounted at runtime from Azure Files / Blob;
# the directories must exist for the config loader
RUN mkdir -p /app/data/raw /app/data/processed /app/data/external \
             /app/artifacts/models /app/artifacts/reports /app/artifacts/figures

# run as a non-root user (Container Apps hardening baseline)
RUN useradd --create-home --uid 10001 drg && chown -R drg:drg /app
USER drg

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "drg.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
