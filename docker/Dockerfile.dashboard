# =============================================================================
# DRG Streamlit dashboard -- Azure Container Apps
# =============================================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DRG_DATA_DIR=/app/data \
    DRG_ARTIFACT_DIR=/app/artifacts \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libgomp1 curl \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-azure.txt ./
RUN pip install --upgrade pip \
 && pip install -r requirements.txt -r requirements-azure.txt

COPY pyproject.toml README.md ./
COPY configs ./configs
COPY src ./src
COPY .streamlit ./.streamlit
RUN pip install --no-deps -e .

RUN mkdir -p /app/data/processed /app/data/external \
             /app/artifacts/models /app/artifacts/reports /app/artifacts/figures

RUN useradd --create-home --uid 10001 drg && chown -R drg:drg /app
USER drg

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "src/drg/dashboard/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0"]
